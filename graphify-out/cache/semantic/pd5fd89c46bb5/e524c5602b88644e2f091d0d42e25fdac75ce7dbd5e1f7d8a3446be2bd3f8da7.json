{"nodes": [{"id": "docs_adr_adr_013_route_proposal_and_operator_override", "label": "ADR-013: Route Proposal and Operator Override", "file_type": "document", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_013_route_sequence_bug", "label": "Operator Route Order Didn't Match Farmer route_position", "file_type": "rationale", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The operator's route summary numbered plots by result.outcomes's incidental plot-id sort order, not route_position, so the operator and farmers could see three different numbers for the same route. Fixed as a standalone prerequisite before RouteOverride, so the new audit trail isn't built on a wrong sequence."}, {"id": "docs_adr_adr_013_route_override_entity", "label": "RouteOverride Entity", "file_type": "concept", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_013_proposal_not_gatekeeping", "label": "Propose, Never Gatekeep (Separate Notification from Authority)", "file_type": "rationale", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holding the route for operator acceptance before notifying farmers was rejected: an unreachable operator would mean no farmer learns anything that day, a silent total failure worse than an occasional override. The agent still acts; only the operator's own message is framed as an editable proposal."}, {"id": "docs_adr_adr_013_reorder_vs_drop_fairness", "label": "Only Confirmed Drop Writes a LedgerEntry", "file_type": "rationale", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Corrected on review: a pure reorder doesn't remove a farmer from today's harvest (the plot is already marked harvested at dispatch, before route order matters), so it has no fairness consequence; only a confirmed drop -- which un-harvests the plot -- writes a fairness bump."}, {"id": "docs_adr_adr_013_decided_by_field", "label": "LedgerEntry.decided_by Three-Valued Attribution", "file_type": "concept", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_013_proxy_registration", "label": "/addfarmer Proxy Registration for Phone-less Farmers", "file_type": "concept", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_013_operator_only_no_helper_role", "label": "Operator-Only Proxy Registration, No Helper Role", "file_type": "rationale", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A helper role would need its own provisioning, revocation, audit rows, and failure paths for a speculative need at eight-farmers-per-cluster scale -- building a general-purpose role system for a hypothesis is exactly the premature abstraction this project's discipline refuses elsewhere."}, {"id": "docs_adr_adr_013_linkfarmer_mechanism", "label": "/linkfarmer Duplicate-Linking Mechanism", "file_type": "concept", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_013_linkfarmer_undo", "label": "Bounded-Window Undo for /linkfarmer", "file_type": "rationale", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apply_link never deletes anything and touches exactly three plain fields, so reversing it within a 1-hour window is the same writes run backward, not a new merge primitive -- added after the initial 'no recovery' decision was reconsidered."}, {"id": "docs_adr_adr_013_rollover_exclusion_gap_fix", "label": "Reachability Decides Whether Rollover Prompt Is Written At All", "file_type": "rationale", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "run_season_rollover previously wrote a SeasonRolloverPrompt even for an unreachable farmer, which -- under ADR-011's exclusion filter -- would silently and permanently exclude a designed-to-be-phone-less farmer from every future season. Fixed: no chat_id means no prompt is written at all, falling through to the existing 'no record = include by default' rule."}, {"id": "docs_adr_adr_013_farmer_why", "label": "'Why?' Button, Stored-Records-Only Answers", "file_type": "concept", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_013_why_not_live_recompute", "label": "Why-Answers Use Stored DecisionRecord, Never Live Recompute", "file_type": "rationale", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "project_maturity_for_plot() makes a live Open-Meteo call, so tapping the same old message twice could return two different answers to 'why wasn't my plot ready' -- exactly the failure explain_decision.py's own rule forbids. Everything is read from the DecisionRecord frozen at decision time instead."}, {"id": "docs_adr_adr_013_tamil_doubled_noun_bug", "label": "why_lost_text Doubled-Noun Grammar Bug Found Live", "file_type": "rationale", "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "why_lost_text's fallback winner_name built a doubled-noun phrase ('the selected plot's plot') in both languages when the winning plot's farmer couldn't be resolved; the existing test only asserted DEFAULT_WINNER_LABEL was a substring, which was true of the broken string too, so it didn't catch the doubling."}], "edges": [{"source": "docs_adr_adr_013_route_proposal_and_operator_override", "target": "docs_adr_adr_013_route_sequence_bug", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_013_route_sequence_bug", "target": "src_harvest_convoy_telegram_notify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_013_route_proposal_and_operator_override", "target": "docs_adr_adr_013_route_override_entity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-013-route-proposal-and-operator-override.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_013_route_override_entity", "target": "src_harvest_convoy_storage_interface", "relation": "references", "confidence": "EXTRACTED", "co