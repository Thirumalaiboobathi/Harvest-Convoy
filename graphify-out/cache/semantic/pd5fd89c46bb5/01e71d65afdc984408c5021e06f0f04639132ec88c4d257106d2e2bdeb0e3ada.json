{"nodes": [{"id": "docs_adr_adr_014_help_command", "label": "ADR-014: /help Command", "file_type": "document", "source_file": "docs/adr/ADR-014-help-command.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_014_help_command_exception", "label": "/help as the One Deliberate Farmer-Initiated Exception", "file_type": "rationale", "source_file": "docs/adr/ADR-014-help-command.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A farmer-typed command fits neither 'agent speaks first' nor 'bounded one-tap reply' -- granted anyway because it's one exact matched string, a deterministic read of already-stored data, no keyboard, no follow-up, and explicitly not a precedent for a second command."}, {"id": "docs_adr_adr_014_help_farmer_operator_tiebreak", "label": "Farmer View Wins When chat_id Is Both Farmer and Operator", "file_type": "rationale", "source_file": "docs/adr/ADR-014-help-command.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reversed on review: the original draft checked operator status first, so an operator who also farms would never see his own plot through /help -- now the farmer view always wins, with an appended operator-commands addendum line."}, {"id": "docs_adr_adr_014_help_no_live_recompute", "label": "Projected-Ready Date From AdvanceNoticeRecord Only", "file_type": "rationale", "source_file": "docs/adr/ADR-014-help-command.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejects a live recompute for the same reason ADR-013 Part 3 does -- reads the same frozen AdvanceNoticeRecord.projected_maturity_date the farmer was already told, so two taps can't disagree."}], "edges": [{"source": "docs_adr_adr_014_help_command", "target": "docs_adr_adr_014_help_command_exc