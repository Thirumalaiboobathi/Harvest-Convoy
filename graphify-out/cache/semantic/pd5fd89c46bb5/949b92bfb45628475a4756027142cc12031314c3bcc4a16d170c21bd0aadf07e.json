{"nodes": [{"id": "docs_adr_adr_008_tn_generalization_and_tamil", "label": "ADR-008: TN Generalization and Tamil", "file_type": "document", "source_file": "docs/adr/ADR-008-tn-generalization-and-tamil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_008_theni_reference_rename", "label": "Theni Constant Renamed to Reference + Per-Cluster Calibration", "file_type": "rationale", "source_file": "docs/adr/ADR-008-tn-generalization-and-tamil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applying the Theni-derived threshold to Thanjavur's real weather produces a measured ~9-day earlier maturity call; rather than just rename the constant, Cluster gains maturity_gdd_override derived per cluster from its own climatology."}, {"id": "docs_adr_adr_008_calibration_module", "label": "agronomy/calibration.py Per-Cluster GDD", "file_type": "concept", "source_file": "docs/adr/ADR-008-tn-generalization-and-tamil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_008_naducauvery_cluster", "label": "Second Cluster: Naducauvery, Thanjavur", "file_type": "concept", "source_file": "docs/adr/ADR-008-tn-generalization-and-tamil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_008_multicluster_watcher", "label": "run_daily_watch Multi-Cluster Iteration", "file_type": "concept", "source_file": "docs/adr/ADR-008-tn-generalization-and-tamil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_008_farmer_language_field", "label": "Farmer.language Field", "file_type": "concept", "source_file": "docs/adr/ADR-008-tn-generalization-and-tamil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_008_tamil_generation_failure", "label": "Nova Pro Cannot Generate Valid Tamil Script", "file_type": "rationale", "source_file": "docs/adr/ADR-008-tn-generalization-and-tamil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live-verified: 8 real advocate calls produced grammatically invalid consonant/vowel-sign clusters in valid Tamil Unicode -- a tokenizer-level limitation, not a prompting problem. Tanglish (romanized Tamil) came back mostly coherent by contrast."}, {"id": "docs_adr_adr_008_templated_argument", "label": "advocate_argument Templated From Facts", "file_type": "rationale", "source_file": "docs/adr/ADR-008-tn-generalization-and-tamil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Given the Tamil-generation failure, Tamil argument text is deterministically templated from structured facts instead of model-generated; concedes is still the model's genuine live decision."}, {"id": "docs_adr_adr_008_half_translation_bugs", "label": "Half-Translation Bugs Found via Live Telegram Verification", "file_type": "rationale", "source_file": "docs/adr/ADR-008-tn-generalization-and-tamil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "String-level review across 3 rounds declared Tamil 'closed'; only checking a real phone's receipt of the redeployed runtime found location_hint's English compass-direction tail and the invalid '1\u0bb5\u0ba4\u0bc1' ordinal -- proving reading rendered strings in isolation cannot catch every bug."}, {"id": "src_harvest_convoy_models", "label": "models.py", "file_type": "code", "source_file": "docs/adr/ADR-008-tn-generalization-and-tamil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_harvest_con