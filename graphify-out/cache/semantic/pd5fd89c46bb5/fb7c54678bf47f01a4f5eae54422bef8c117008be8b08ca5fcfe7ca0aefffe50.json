{"nodes": [{"id": "docs_adr_adr_010_reporting_decision_replay_equity_machinery", "label": "ADR-010: Reporting and Decision Replay", "file_type": "document", "source_file": "docs/adr/ADR-010-reporting-decision-replay-equity-machinery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_010_part05_finding", "label": "System Computes Reasoning Then Discards It", "file_type": "rationale", "source_file": "docs/adr/ADR-010-reporting-decision-replay-equity-machinery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PlotDecision and AdvocateClaim/EscalationPayload are built fresh each trigger day and discarded; there is no put_decision anywhere in Storage. A reporting script can only be as honest as what it reads, so this is an architectural gap fixed at the source (DecisionRecord), not worked around in the reporting layer."}, {"id": "docs_adr_adr_010_decision_record", "label": "DecisionRecord Entity", "file_type": "concept", "source_file": "docs/adr/ADR-010-reporting-decision-replay-equity-machinery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_010_cloudwatch_not_audit_trail", "label": "CloudWatch Traces Are Not a Substitute for Persistence", "file_type": "rationale", "source_file": "docs/adr/ADR-010-reporting-decision-replay-equity-machinery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Traces only exist where exported (deployed path only), have no recorded link from a plot/date to a trace ID, and have no retention policy -- Storage is the actual system of record, CloudWatch is operational telemetry."}, {"id": "docs_adr_adr_010_explain_decision_script", "label": "explain_decision.py Replay Tool", "file_type": "concept", "source_file": "docs/adr/ADR-010-reporting-decision-replay-equity-machinery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_010_equity_report_script", "label": "equity_report.py Fairness Report", "file_type": "concept", "source_file": "docs/adr/ADR-010-reporting-decision-replay-equity-machinery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_010_machinery_gap_script", "label": "machinery_gap.py Report", "file_type": "concept", "source_file": "docs/adr/ADR-010-reporting-decision-replay-equity-machinery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_010_retention_forever", "label": "DecisionRecord Retained Indefinitely", "file_type": "rationale", "source_file": "docs/adr/ADR-010-reporting-decision-replay-equity-machinery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No automatic deletion or season-rollover clearing -- an audit trail that quietly expires is not an audit trail, and this ADR exists because the system's previous audit trail (discard-after-use) already failed exactly that test."}], "edges": [{"source": "docs_adr_adr_010_reporting_decision_replay_equity_machinery", "target": "docs_adr_adr_010_part05_finding", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-010-reporting-decision-replay-equity-machinery.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_010_part05_finding", "target": "docs_adr_adr_010_decision_record", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-010-reporting-decision-replay-equity-machinery.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_010_decision_record", "target": "src_harvest_convoy_storage_interfa